---
import Base from './Base.astro'
import { DOCS_URL } from '@/data/links'

interface Props {
  title: string
  description?: string
}
const { title, description } = Astro.props

const docs = [
  { label: 'Overview', href: '/docs' },
  { label: 'Installation', href: '/docs/installation' },
  { label: 'Configuration', href: '/docs/configuration' },
  { label: 'Reverse proxy and TLS', href: '/docs/reverse-proxy' },
  { label: 'First run', href: '/docs/first-run' },
]
const current = Astro.url.pathname.replace(/\/$/, '') || '/docs'
---

<Base title={`${title} - AudioSilo Docs`} description={description}>
  <div class="shell py-12 sm:py-16">
    <div class="flex flex-col gap-10 md:flex-row md:gap-14">
      <aside class="md:w-60 md:shrink-0">
        <div class="md:sticky md:top-[calc(var(--header-h)+2rem)]">
          <p class="t-eyebrow mb-3 px-3">Quick start</p>
          <nav class="flex flex-row flex-wrap gap-1 md:flex-col" aria-label="Documentation">
            {
              docs.map((d) => (
                <a
                  href={d.href}
                  aria-current={current === d.href ? 'page' : undefined}
                  class="rounded-xl px-3 py-2 text-sm text-muted-foreground transition-colors hover:bg-foreground/[0.05] hover:text-foreground aria-[current=page]:bg-foreground/[0.07] aria-[current=page]:font-semibold aria-[current=page]:text-foreground"
                >
                  {d.label}
                </a>
              ))
            }
          </nav>
          <div class="mt-6 rounded-2xl bg-muted/70 p-4 text-sm shadow-[inset_0_0_0_1px_var(--border)]">
            <p class="text-muted-foreground">These pages are the short version. The full user guide and developer docs live at</p>
            <a href={DOCS_URL} target="_blank" rel="noopener" class="link mt-1 inline-block font-semibold">docs.audiosilo.app</a>
          </div>
        </div>
      </aside>
      <article class="prose-as min-w-0 max-w-[70ch] flex-grow">
        <h1 class="t-display mb-8">{title}</h1>
        <slot />
      </article>
    </div>
  </div>
</Base>

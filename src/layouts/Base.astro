---
import '@fontsource-variable/bricolage-grotesque/opsz.css'
import '@fontsource-variable/figtree'
import '@fontsource-variable/jetbrains-mono'
import '../styles/global.css'
import Header from '@/components/site/Header.astro'
import Footer from '@/components/site/Footer.astro'
import MiniBar from '@/components/site/MiniBar.astro'

interface Props {
  title?: string
  description?: string
  /** The page's first section is a full-bleed hero that runs under the header. */
  hasHero?: boolean
  /** Show the phone mini bar (off on pages that are themselves about the demo's limits, never needed). */
  miniBar?: boolean
}

const {
  title = 'AudioSilo - your audiobooks, your server, every screen',
  description = 'AudioSilo is a free, self-hosted audiobook server with a player for the web, iPhone and iPad, and an open community metadata database. Try the demo in your browser, no sign-up.',
  hasHero = false,
  miniBar = true,
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site).href
const ogImage = new URL('/og.png', Astro.site).href
---

<!doctype html>
<html lang="en-GB" class="dark" data-theme="dark" style="color-scheme: dark">
  <head>
    <meta charset="utf-8" />
    <!-- Dark is the default; the script below repoints this at the resolved theme. -->
    <meta name="theme-color" content="#0a0f1e" />
    <!-- Before first paint: mark JS, then resolve the theme with no flash
         (localStorage 'theme': light | dark | system). No stored choice means
         dark, the site default; only 'system' follows the OS. Keep in step
         with src/lib/theme.ts. -->
    <script is:inline>
      ;(function () {
        var root = document.documentElement
        root.classList.add('js')
        var mq = window.matchMedia('(prefers-color-scheme: dark)')
        function stored() {
          try {
            var v = localStorage.getItem('theme')
            if (v === 'light' || v === 'dark' || v === 'system') return v
          } catch (e) {}
          return 'dark' // no stored choice (or storage blocked): the dark default
        }
        function apply(pref) {
          var dark = pref === 'dark' || (pref === 'system' && mq.matches)
          root.classList.toggle('dark', dark)
          root.dataset.theme = dark ? 'dark' : 'light'
          root.dataset.themePreference = pref
          root.style.colorScheme = dark ? 'dark' : 'light'
          var meta = document.querySelector('meta[name="theme-color"]')
          if (meta) meta.setAttribute('content', dark ? '#0a0f1e' : '#f5f7fa')
        }
        apply(stored())
        mq.addEventListener('change', function () {
          if (root.dataset.themePreference === 'system') apply('system')
        })
        window.addEventListener('storage', function (e) {
          if (e.key === 'theme' || e.key === null) apply(stored())
        })
      })()
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#db2777" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AudioSilo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AudioSilo - your audiobooks, your server, every screen" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-foreground"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class:list={['flex-grow', !hasHero && 'pt-(--header-h)']}>
      <slot />
    </main>
    <Footer />
    {miniBar && <MiniBar />}
    <script>
      import '@/lib/site'
    </script>
  </body>
</html>

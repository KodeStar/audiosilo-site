---
// A small set of inline icons so the site needs no external icon font/kit.
// `outlinePaths` are Heroicons v2 (outline) drawn with a stroke; `filledPaths`
// are solid brand/glyph icons drawn with a fill. Add new glyphs to either map.
// Other attributes (e.g. data-slot) pass through to the <svg>.
import type { HTMLAttributes } from 'astro/types'

interface Props extends Omit<HTMLAttributes<'svg'>, 'name'> {
  name: keyof typeof outlinePaths | keyof typeof filledPaths
}

const outlinePaths = {

const { name, class: className = 'w-6 h-6', ...rest } = Astro.props
const filled = name in filledPaths
const d = filled ? filledPaths[name as keyof typeof filledPaths] : outlinePaths[name as keyof typeof outlinePaths]
---
{
  filled ? (
    <svg
      class={className}
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      {...rest}
    >
      <path d={d} />
    </svg>
  ) : (
    <svg
      class={className}
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.5"
      stroke="currentColor"
      aria-hidden="true"
      {...rest}
    >
      <path stroke-linecap="round" stroke-linejoin="round" d={d} />
    </svg>
  )
}

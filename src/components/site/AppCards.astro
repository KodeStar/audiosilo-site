---
/**
 * Where to get the player: web, iPhone and iPad, Android. Every word about
 * store availability comes from src/data/status.ts. The web card's body is
 * the default slot (it differs per page); `pairNote` adds a line to the iOS
 * card. While the 2.0 apps are in beta, both app cards offer the Discord ask.
 */
import Arrow from './Arrow.astro'
import Icon from '@/components/Icon.astro'
import { APP_STORE_URL } from '@/data/links'
import {
  ANDROID_HEADING,
  ANDROID_LIVE,
  ANDROID_NOTE,
  BETA_LABEL,
  BETA_URL,
  IOS_2_IN_STORE,
  IOS_APP_NOTE,
} from '@/data/status'

interface Props {
  webTitle: string
  pairNote?: string
}
const { webTitle, pairNote } = Astro.props
---

<div class="grid gap-4 md:grid-cols-3">
  <article class="tile reveal flex flex-col p-6 sm:p-7">
    <p class="t-eyebrow">Web</p>
    <h3 class="t-heading mt-2">{webTitle}</h3>
    <slot />
  </article>
  <article class="tile reveal reveal-d1 flex flex-col p-6 sm:p-7">
    <p class="t-eyebrow">iPhone and iPad</p>
    <h3 class="t-heading mt-2">On the App Store</h3>
    <p class="mt-3 text-[0.9375rem] text-foreground/80">{IOS_APP_NOTE}{pairNote && ` ${pairNote}`}</p>
    <div class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-3 pt-5">
      <a
        href={APP_STORE_URL}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2.5 rounded-xl bg-[#05070f] px-4 py-2 text-white ring-1 ring-white/15 transition-transform hover:-translate-y-0.5"
        aria-label="Download AudioSilo on the App Store"
      >
        <Icon name="apple" class="size-6" />
        <span class="flex flex-col leading-tight"><span class="text-[10px] tracking-wide uppercase opacity-80">Download on the</span><span class="text-base font-semibold">App Store</span></span>
      </a>
      {
        !IOS_2_IN_STORE && (
          <a href={BETA_URL} target="_blank" rel="noopener" class="group inline-flex items-center gap-1.5 text-sm font-semibold">
            Try the 2.0 beta <Arrow />
          </a>
        )
      }
    </div>
  </article>
  <article class="tile reveal reveal-d2 flex flex-col p-6 sm:p-7">
    <p class="t-eyebrow">Android</p>
    <h3 class="t-heading mt-2">{ANDROID_HEADING}</h3>
    <p class="mt-3 text-[0.9375rem] text-foreground/80">{ANDROID_NOTE}</p>
    {
      !ANDROID_LIVE && (
        <a href={BETA_URL} target="_blank" rel="noopener" class="group mt-auto inline-flex items-center gap-1.5 pt-5 text-sm font-semibold">
          {BETA_LABEL} <Arrow />
        </a>
      )
    }
  </article>
</div>

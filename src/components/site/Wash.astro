---
/**
 * The now-playing wash: a cover palette drifting behind a section. Place it
 * as the first child of a `relative isolate` section. CSS lives in global.css
 * (.wash); it only animates on screen and never under reduced motion.
 */
import { cn } from '@/lib/utils'

export type Palette = 'oz' | 'dracula' | 'treasure' | 'community' | 'console' | 'ember' | 'carol'

interface Props {
  palette: Palette
  /** 'fade' (default) fades into the page at both edges; 'none' no fade (inside tiles). */
  edge?: 'fade' | 'none'
  class?: string
}

const { palette, edge = 'fade', class: className } = Astro.props
---

<div
  class={cn('wash', `pal-${palette}`, edge === 'none' && 'wash-none', className)}
  aria-hidden="true"
>
  <i></i><i></i><i></i>
</div>

---
/**
 * "Try it tonight": the demo as the player's Now card. Cover, title, a
 * whole-book scale and the bar seek bar; the round pink play button IS the
 * demo link. Beside it, a minute's checklist and an honest note about what
 * the demo can't show.
 */
import { demoBooks, demoChecklist, demoLibrary } from '@/data/demo'
import { DEMO_URL } from '@/data/links'
import DemoCover from './DemoCover.astro'
import BarScrubber from './BarScrubber.astro'
import PlayLink from './PlayLink.astro'
import Wash from './Wash.astro'

interface Props {
  /** Heading level for the card title. */
  headingId?: string
}
const { headingId = 'try-tonight' } = Astro.props
const book = demoBooks.find((b) => b.key === 'carol')!
---

<div class="grid gap-6 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] lg:gap-8">
  <article class="tile reveal p-5 sm:p-8" aria-labelledby={headingId}>
    <Wash palette="carol" edge="none" />
    <div class="relative z-10">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:gap-8">
        <DemoCover book={book.key} class="w-36 shrink-0 sm:w-48" />
        <div class="min-w-0">
          <p class="t-eyebrow text-foreground/70">Tonight in the demo &middot; 1 of {demoLibrary.count} books</p>
          <h3 id={headingId} class="mt-2 font-display text-[clamp(2rem,4.2vw,3.25rem)] leading-[0.95] font-bold tracking-[-0.04em]">
            {book.title}
          </h3>
          <p class="mt-2 text-[0.9375rem] text-foreground/75">{book.author} &middot; {book.hours} &middot; a LibriVox recording</p>
        </div>
      </div>

      <BarScrubber class="mt-8 h-12 sm:h-14" bars={84} played={0.06} seed={12} />
      <div class="mt-2 flex justify-between font-mono text-[11px] text-foreground/60 tabular-nums" aria-hidden="true">
        <span>0:12</span><span>1x</span><span>-3:29:48</span>
      </div>

      <div class="mt-6 flex items-center justify-center gap-6 sm:gap-10">
        <span class="grid size-12 place-items-center rounded-full text-foreground/70" aria-hidden="true">
          <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7" /><path d="M3 4v5h5" /><text x="12" y="15.5" font-size="7" font-weight="700" text-anchor="middle" fill="currentColor" stroke="none" font-family="Figtree Variable, sans-serif">15</text></svg>
        </span>
        <PlayLink size="xl" label="Press play: open the demo" />
        <span class="grid size-12 place-items-center rounded-full text-foreground/70" aria-hidden="true">
          <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7" /><path d="M21 4v5h-5" /><text x="12" y="15.5" font-size="7" font-weight="700" text-anchor="middle" fill="currentColor" stroke="none" font-family="Figtree Variable, sans-serif">30</text></svg>
        </span>
      </div>
      <p class="mt-5 text-center text-sm font-medium">
        Press play to open the demo.
        <span class="block text-foreground/70">No sign-up, nothing to install. It opens the real web player.</span>
      </p>
    </div>
  </article>

  <div class="reveal reveal-d1 flex flex-col gap-6">
    <div>
      <h3 class="t-heading">A minute in the demo</h3>
      <ol class="mt-4 space-y-3">
        {
          demoChecklist.map((item, i) => (
            <li class="flex gap-3 text-[0.9375rem] leading-snug">
              <span class="mt-px grid size-6 shrink-0 place-items-center rounded-full bg-foreground/[0.07] font-mono text-[11px] font-semibold tabular-nums">{i + 1}</span>
              <span>{item}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="rounded-2xl bg-muted/70 p-5 text-sm leading-relaxed text-muted-foreground shadow-[inset_0_0_0_1px_var(--border)]">
      <p class="font-semibold text-foreground">What the demo can't show</p>
      <p class="mt-1.5">
        {demoLibrary.metadataNote} Visitors don't get the admin console either; the server tour
        shows it. Your demo account is thrown away after a day or so idle.
      </p>
      <ul class="mt-4 flex flex-wrap gap-2" aria-label={`The demo's library: ${demoLibrary.shelfLong}`}>
        {
          demoBooks.map((b) => (
            <li class="flex items-center gap-2 rounded-full bg-background/80 py-1 pr-3 pl-1 shadow-[inset_0_0_0_1px_var(--border)]">
              <DemoCover book={b.key} class="w-6 rounded-[3px]" />
              <span class="text-xs text-foreground/85">{b.title}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <a href={DEMO_URL} target="_blank" rel="noopener" class="link w-fit text-sm font-semibold">Open the demo in a new tab</a>
  </div>
</div>

---
/**
 * The player's bar-style seek bar: a deterministic speech-like pattern of
 * bars (a pattern, not a waveform - heights say nothing about loudness),
 * played bars in ink, a playhead with a halo, optional bookmark ticks above.
 * Decorative.
 */
import { barHeights } from '@/lib/bars'
import { cn } from '@/lib/utils'

interface Props {
  bars?: number
  /** 0..1 */
  played?: number
  seed?: number
  /** Fractions (0..1) where bookmark ticks sit. */
  marks?: number[]
  class?: string
}

const { bars = 72, played = 0.32, seed = 7, marks = [], class: className } = Astro.props

const heights = barHeights(bars, seed)
const playedCount = Math.round(bars * played)
---

<div class={cn('relative', className)} aria-hidden="true">
  {
    marks.map((m) => (
      <span class="absolute -top-3.5 -translate-x-1/2 text-foreground/60" style={`left:${m * 100}%`}>
        <svg class="size-2.5" viewBox="0 0 24 24" fill="currentColor"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1Z" /></svg>
      </span>
    ))
  }
  <div class="bars h-full">
    {heights.map((h, i) => <i class={i < playedCount ? 'played' : undefined} style={`--h:${h.toFixed(3)}`} />)}
  </div>
  <span
    class="absolute top-1/2 h-[135%] w-[3px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-foreground shadow-[0_0_0_4px_color-mix(in_oklab,var(--foreground)_14%,transparent)]"
    style={`left:${(playedCount / bars) * 100}%`}
  ></span>
</div>

---
/**
 * An app store badge (App Store, Google Play): store glyph plus a two-line
 * label. The visible label is the accessible name, plus the site's
 * "(opens in a new tab)" hint. Each store's link and wording live here, so
 * every page shows the same badge.
 */
import Icon from '@/components/Icon.astro'
import { APP_STORE_URL, PLAY_STORE_URL } from '@/data/links'

const STORES = {
  apple: { href: APP_STORE_URL, eyebrow: 'Download on the', label: 'App Store' },
  googleplay: { href: PLAY_STORE_URL, eyebrow: 'Get it on', label: 'Google Play' },
} as const

interface Props {
  store: keyof typeof STORES
}
const { store } = Astro.props
const { href, eyebrow, label } = STORES[store]
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  class="inline-flex items-center gap-2.5 rounded-xl bg-[#05070f] px-4 py-2 text-white ring-1 ring-white/15 transition-transform hover:-translate-y-0.5"
>
  <Icon name={store} class="size-6" />
  <span class="flex flex-col leading-tight">
    <span class="text-[10px] tracking-wide uppercase opacity-80">{eyebrow}</span>
    <span class="text-base font-semibold">{label}</span>
  </span>
  <span class="sr-only">(opens in a new tab)</span>
</a>

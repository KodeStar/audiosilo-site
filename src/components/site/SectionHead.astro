---
import { cn } from '@/lib/utils'

interface Props {
  eyebrow?: string
  title: string
  lede?: string
  align?: 'left' | 'center'
}

const { eyebrow, title, lede, align = 'left' } = Astro.props
---

<div class={cn('reveal max-w-3xl', align === 'center' && 'mx-auto text-center')}>
  {eyebrow && <p class="t-eyebrow mb-4">{eyebrow}</p>}
  <h2 class="t-display">{title}</h2>
  {lede && <p class={cn('t-lede mt-5', align === 'center' && 'mx-auto max-w-2xl')}>{lede}</p>}
  <slot />
</div>

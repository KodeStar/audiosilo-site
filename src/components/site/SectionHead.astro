---
import { cn } from '@/lib/utils'

interface Props {
  eyebrow?: string
  title: string
  lede?: string
  align?: 'left' | 'center'
  as?: 'h1' | 'h2'
  size?: 'display' | 'hero'
  class?: string
}

const { eyebrow, title, lede, align = 'left', as: Tag = 'h2', size = 'display', class: className } = Astro.props
---

<div class={cn('reveal', align === 'center' ? 'mx-auto max-w-3xl text-center' : 'max-w-3xl', className)}>
  {eyebrow && <p class="t-eyebrow mb-4">{eyebrow}</p>}
  <Tag class={size === 'hero' ? 't-hero' : 't-display'}>{title}</Tag>
  {lede && <p class={cn('t-lede mt-5', align === 'center' && 'mx-auto max-w-2xl')}>{lede}</p>}
  <slot />
</div>

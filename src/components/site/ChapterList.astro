---
/**
 * The pillar pages' sticky "chapter list" (desktop): the page's sections as
 * the player lists a book's chapters. The current one is marked with the live
 * equaliser; src/lib/site.ts keeps aria-current in step with the scroll.
 * Indices match the page's [data-chapter] sections in DOM order.
 */
interface Props {
  title: string
  chapters: { id: string; title: string }[]
}
const { title, chapters } = Astro.props
---

<nav aria-label={`${title}: on this page`} class="sticky top-[calc(var(--header-h)+2rem)] hidden w-60 shrink-0 self-start lg:block">
  <p class="t-eyebrow mb-3 px-3">{chapters.length} chapters</p>
  <ol class="space-y-0.5">
    {
      chapters.map((c, i) => (
        <li>
          <a
            href={`#${c.id}`}
            data-chapter-link={i}
            class="group flex items-center gap-3 rounded-xl px-3 py-2 text-sm text-muted-foreground transition-colors hover:bg-foreground/[0.05] hover:text-foreground aria-[current=true]:bg-foreground/[0.06] aria-[current=true]:font-semibold aria-[current=true]:text-foreground"
          >
            <span class="w-5 font-mono text-[11px] tabular-nums opacity-70 group-aria-[current=true]:hidden">{String(i + 1).padStart(2, '0')}</span>
            <span class="hidden w-5 group-aria-[current=true]:inline-flex" aria-hidden="true"><span class="eq"><i /><i /><i /></span></span>
            <span class="min-w-0 truncate">{c.title}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

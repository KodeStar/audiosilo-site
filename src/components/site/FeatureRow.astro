---
/**
 * A page chapter: large media with a short caption beside it. The section
 * registers with the header seek bar and the chapter list via data-chapter.
 */
import { cn } from '@/lib/utils'

interface Props {
  id: string
  chapter: string
  eyebrow?: string
  title: string
  /** Media on the right instead of the left (desktop). */
  flip?: boolean
  /** Column split: 'wide' gives media 7/12, 'even' 6/12, 'tall' 5/12 (for phones). */
  split?: 'wide' | 'even' | 'tall'
  /** On phones, put the caption above the media (for code, not screens). */
  textFirst?: boolean
}
const { id, chapter, eyebrow, title, flip = false, split = 'wide', textFirst = false } = Astro.props
const media = { wide: 'xl:col-span-7', even: 'xl:col-span-6', tall: 'xl:col-span-5' }[split]
const text = { wide: 'xl:col-span-5', even: 'xl:col-span-6', tall: 'xl:col-span-7' }[split]
---

<section id={id} data-chapter={chapter} class="relative scroll-mt-24 py-14 sm:py-20">
  <div class="grid items-center gap-8 xl:grid-cols-12 xl:gap-12">
    <div class={cn('reveal min-w-0', media, flip && 'xl:order-2', textFirst && 'order-2 xl:order-none')}>
      <slot name="media" />
    </div>
    <div class={cn('reveal reveal-d1 min-w-0', text)}>
      {eyebrow && <p class="t-eyebrow mb-3">{eyebrow}</p>}
      <h2 class="t-title">{title}</h2>
      <div class="mt-4 space-y-4 text-[1.0625rem] leading-relaxed text-foreground/80">
        <slot />
      </div>
    </div>
  </div>
</section>

---
/**
 * Typographic covers for the six books in the public demo (the Stacks idea
 * of a procedural cover: no fake art, just the book's own title set well).
 * Sized by its container; text scales with container units.
 */
import { demoBooks, type DemoBookKey } from '@/data/demo'
import { cn } from '@/lib/utils'

interface Props {
  book: DemoBookKey
  class?: string
}

const { book, class: className } = Astro.props
const b = demoBooks.find((x) => x.key === book)!
const serif = "font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif"
---

<div
  class={cn('demo-cover @container relative aspect-square overflow-hidden rounded-[6px] text-white', `cover-${book}`, className)}
  style="box-shadow: var(--shadow-cover)"
  role="img"
  aria-label={`${b.title} by ${b.author}`}
>
  {
    book === 'carol' && (
      <>
        <div class="absolute inset-0 bg-[radial-gradient(90%_70%_at_50%_0%,#c23a4f,transparent_70%),linear-gradient(160deg,#8f1d33,#4a0d1c)]" />
        <div class="absolute inset-[6%] rounded-[3px] border border-[#e6c27a]/60" />
        <svg class="absolute top-[14%] left-1/2 w-[16%] -translate-x-1/2 text-[#e6c27a]" viewBox="0 0 24 24" fill="currentColor"><path d="m12 2 2.4 6.9H22l-6 4.4 2.3 7L12 16l-6.3 4.3 2.3-7-6-4.4h7.6Z" /></svg>
        <p class="absolute inset-x-[12%] top-[36%] text-center text-[13cqw] leading-[0.95] font-semibold text-[#f6e3b4]" style={serif}>A Christmas Carol</p>
        <p class="absolute inset-x-0 bottom-[11%] text-center text-[5.2cqw] tracking-[0.2em] text-[#e6c27a] uppercase">Charles Dickens</p>
      </>
    )
  }
  {
    book === 'wild' && (
      <>
        <div class="absolute inset-0 bg-[linear-gradient(180deg,#0f1f45,#27427a_62%,#dfe8f5_62.5%,#f4f7fb)]" />
        <div class="absolute top-[14%] right-[16%] size-[22%] rounded-full bg-[#f4efd8] shadow-[0_0_40px_10px_rgb(244_239_216/0.35)]" />
        <svg class="absolute bottom-[37%] left-0 w-full text-[#0b1631]" viewBox="0 0 100 20" preserveAspectRatio="none" fill="currentColor"><path d="M0 20 L14 8 L22 14 L34 2 L48 15 L58 9 L70 16 L82 5 L100 18 L100 20Z" /></svg>
        <p class="absolute inset-x-[9%] bottom-[18%] text-[10.5cqw] leading-[0.92] font-extrabold tracking-[-0.03em] text-[#0f1f45] uppercase" style="font-family: var(--font-display)">The Call of the Wild</p>
        <p class="absolute inset-x-[9%] bottom-[8%] text-[5cqw] font-semibold tracking-[0.14em] text-[#27427a] uppercase">Jack London</p>
      </>
    )
  }
  {
    book === 'pride' && (
      <>
        <div class="absolute inset-0 bg-[#e9d9cc]" />
        <div class="absolute inset-[7%] border-[1.5px] border-[#7b4a52]/70" />
        <div class="absolute inset-[10%] border border-[#7b4a52]/40" />
        <p class="absolute inset-x-[14%] top-[28%] text-center text-[13cqw] leading-[0.95] text-[#5a2c36] italic" style={serif}>Pride and Prejudice</p>
        <div class="absolute top-[68%] left-1/2 h-px w-[20%] -translate-x-1/2 bg-[#7b4a52]/60" />
        <p class="absolute inset-x-0 bottom-[16%] text-center text-[5.2cqw] tracking-[0.22em] text-[#7b4a52] uppercase">Jane Austen</p>
      </>
    )
  }
  {
    book === 'alice' && (
      <>
        <div class="absolute inset-0 bg-[radial-gradient(80%_80%_at_70%_20%,#2fb3a8,transparent_70%),#0d5c63]" />
        <div class="absolute top-[12%] left-[12%] grid h-[34%] w-[26%] rotate-[-10deg] place-items-center rounded-[4px] bg-[#fdf6e9] text-[14cqw] leading-none text-[#c23a4f] shadow-lg" style={serif}>&hearts;</div>
        <div class="absolute top-[16%] left-[34%] grid h-[34%] w-[26%] rotate-[8deg] place-items-center rounded-[4px] bg-[#fdf6e9] text-[14cqw] leading-none text-[#14213d] shadow-lg" style={serif}>&spades;</div>
        <p class="absolute inset-x-[10%] bottom-[20%] text-[12cqw] leading-[0.95] font-semibold text-[#fdf6e9]" style={serif}>Alice in Wonderland</p>
        <p class="absolute inset-x-[10%] bottom-[9%] text-[5cqw] tracking-[0.16em] text-[#bfeee8] uppercase">Lewis Carroll</p>
      </>
    )
  }
  {
    book === 'sherlock' && (
      <>
        <div class="absolute inset-0 bg-[linear-gradient(150deg,#3b1418,#1c0a0c)]" />
        <div class="absolute top-[13%] left-1/2 size-[30%] -translate-x-1/2 rounded-full border-[3px] border-[#d9a441]" />
        <div class="absolute top-[38%] left-[58%] h-[16%] w-[3%] rotate-[-40deg] rounded-full bg-[#d9a441]" />
        <p class="absolute inset-x-[8%] top-[56%] text-center text-[5.2cqw] tracking-[0.2em] text-[#d9a441] uppercase">The Adventures of</p>
        <p class="absolute inset-x-[8%] top-[64%] text-center text-[12.5cqw] leading-[0.95] font-semibold text-[#f3e6cf]" style={serif}>Sherlock Holmes</p>
        <p class="absolute inset-x-0 bottom-[7%] text-center text-[4.6cqw] tracking-[0.16em] text-[#d9a441]/80 uppercase">Arthur Conan Doyle</p>
      </>
    )
  }
  {
    book === 'war' && (
      <>
        <div class="absolute inset-0 bg-[#141414]" />
        <div class="absolute top-[12%] right-[12%] grid size-[24%] place-items-center rounded-[3px] bg-[#c8321f] text-[11cqw] leading-none font-bold text-[#141414]" style={serif}>孫</div>
        <div class="absolute top-[12%] bottom-[12%] left-[13%] w-px bg-white/20" />
        <p class="absolute inset-x-[20%] bottom-[22%] text-[14cqw] leading-[0.9] font-extrabold tracking-[-0.04em] text-[#f2ede4] uppercase" style="font-family: var(--font-display)">The Art of War</p>
        <p class="absolute inset-x-[20%] bottom-[11%] text-[5cqw] tracking-[0.2em] text-[#c8321f] uppercase">Sun Tzu</p>
      </>
    )
  }
  <div class="pointer-events-none absolute inset-y-0 left-0 w-[5%] bg-gradient-to-r from-black/25 to-transparent" />
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(135deg,rgb(255_255_255/0.14),transparent_40%)]" />
</div>

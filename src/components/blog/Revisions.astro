---
/**
 * The post's visible change log: its `revisions`, newest first, ending with
 * when it was published; plus the forward link (supersededBy) and the posts
 * it replaces. 'list' is a quiet ledger (designs A and C); 'timeline' a mini
 * timeline of nodes on a line (design B).
 */
import { formatDate, isoDate, type BlogLinks, type Post } from '@/lib/blog'
import { cn } from '@/lib/utils'

interface Props {
  post: Post
  links: BlogLinks
  supersededBy?: Post
  supersedes?: Post[]
  variant?: 'list' | 'timeline'
  title?: string
  class?: string
}
const { post, links, supersededBy, supersedes = [], variant = 'list', title = 'Changes to this post', class: className } = Astro.props

interface Row {
  date: Date
  note: string
  link?: { href: string; label: string; prefix: string }
  kind: 'next' | 'revision' | 'published'
}
const rows: Row[] = [
  ...(supersededBy
    ? [{ date: supersededBy.data.published, note: '', kind: 'next' as const, link: { href: links.post(supersededBy.id), label: supersededBy.data.title, prefix: 'Replaced by' } }]
    : []),
  ...[...post.data.revisions]
    .sort((a, b) => b.date.valueOf() - a.date.valueOf())
    .map((r) => ({ date: r.date, note: r.note, kind: 'revision' as const })),
  { date: post.data.published, note: 'First published.', kind: 'published' as const },
]
const id = `rev-${post.id}`
---

<section aria-labelledby={id} class={cn(className)}>
  {
    variant === 'list' ? (
      <div class="rounded-2xl bg-muted/60 p-5 shadow-[inset_0_0_0_1px_var(--border)] sm:p-6">
        <h2 id={id} class="t-heading">{title}</h2>
        <ol class="mt-4 divide-y divide-border text-[0.9375rem]">
          {rows.map((r) => (
            <li class="grid gap-1 py-3 first:pt-0 last:pb-0 sm:grid-cols-[8.5rem_1fr] sm:gap-4">
              <time datetime={isoDate(r.date)} class="font-mono text-xs leading-6 text-muted-foreground tabular-nums">{formatDate(r.date)}</time>
              <p class="text-foreground/85">
                {r.link ? (
                  <>
                    {`${r.link.prefix} `}<a href={r.link.href} class="link font-semibold">{r.link.label}</a>.
                  </>
                ) : (
                  r.note
                )}
              </p>
            </li>
          ))}
        </ol>
        {supersedes.length > 0 && (
          <p class="mt-4 border-t border-border pt-4 text-sm text-muted-foreground">
            This post replaces{' '}
            {supersedes.map((s, i) => <>{i > 0 && ', '}<a href={links.post(s.id)} class="link">{s.data.title}</a></>)}.
          </p>
        )}
      </div>
    ) : (
      <div>
        <h2 id={id} class="t-eyebrow">{title}</h2>
        <ol class="journal-line mt-5 space-y-5 [--line-x:0.3125rem]">
          {rows.map((r) => (
            <li class="relative grid grid-cols-[0.625rem_1fr] gap-4">
              <span
                class={cn(
                  'relative z-10 mt-[0.4rem] size-2.5 rounded-full',
                  r.kind === 'next' ? 'bg-foreground' : r.kind === 'published' ? 'bg-background shadow-[inset_0_0_0_2px_var(--foreground)]' : 'bg-background shadow-[inset_0_0_0_2px_var(--border-strong)]',
                )}
                aria-hidden="true"
              />
              <div class="min-w-0">
                <time datetime={isoDate(r.date)} class="font-mono text-xs text-muted-foreground tabular-nums">{formatDate(r.date)}</time>
                <p class="mt-0.5 text-[0.9375rem] leading-relaxed text-foreground/85">
                  {r.link ? (
                    <>
                      {`${r.link.prefix} `}<a href={r.link.href} class="link font-semibold">{r.link.label}</a>.
                    </>
                  ) : (
                    r.note
                  )}
                  {r.kind === 'published' && supersedes.length > 0 && (
                    <span class="block text-sm text-muted-foreground">
                      Replaces{' '}
                      {supersedes.map((s, i) => <>{i > 0 && ', '}<a href={links.post(s.id)} class="link">{s.data.title}</a></>)}.
                    </span>
                  )}
                </p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    )
  }
</section>

---
/**
 * Design C's reading scrubber: the player's bar-style seek bar (a pattern,
 * not a waveform), filled and with its playhead moved by the page's scroll.
 * A CSS scroll-driven animation does it where supported (blog.css
 * .read-scrub); elsewhere the small script below sets --read on scroll.
 */
import { barHeights } from '@/lib/bars'
import { cn } from '@/lib/utils'

interface Props {
  seed: number
  class?: string
}
const { seed, class: className } = Astro.props
const heights = barHeights(90, seed).map((h) => h.toFixed(3))
---

<div class={cn('read-scrub relative', className)} aria-hidden="true" data-read-scrub>
  <div class="bars absolute inset-0">{heights.map((h) => <i style={`--h:${h}`} />)}</div>
  <div class="read-ink bars absolute inset-0">{heights.map((h) => <i class="played" style={`--h:${h}`} />)}</div>
  <div class="read-head pointer-events-none absolute inset-0">
    <span class="absolute top-1/2 left-0 h-[135%] w-[3px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-foreground shadow-[0_0_0_4px_color-mix(in_oklab,var(--foreground)_14%,transparent)]"></span>
  </div>
</div>

<script>
  if (!CSS.supports('animation-timeline: scroll()')) {
    const scrubs = document.querySelectorAll<HTMLElement>('[data-read-scrub]')
    let raf = 0
    const paint = () => {
      raf = 0
      const max = document.documentElement.scrollHeight - window.innerHeight
      const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0
      scrubs.forEach((s) => s.style.setProperty('--read', p.toFixed(4)))
    }
    const schedule = () => {
      if (!raf) raf = requestAnimationFrame(paint)
    }
    window.addEventListener('scroll', schedule, { passive: true })
    window.addEventListener('resize', schedule)
    paint()
  }
</script>

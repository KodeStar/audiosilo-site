---
/**
 * A blog listing (the index, a kind or a tag) in one of the three designs,
 * inside the blog's frame. Every listing route renders this.
 */
import BlogShell from './BlogShell.astro'
import AIndex from './a/AIndex.astro'
import BIndex from './b/BIndex.astro'
import CIndex from './c/CIndex.astro'
import { BLOG_DESCRIPTION, BLOG_KINDS, type BlogKind } from '@/data/blog'
import { kindPlural, tagSlug, type BlogLinks, type Post } from '@/lib/blog'

interface Props {
  all: Post[]
  links: BlogLinks
  kind?: BlogKind
  /** The tag as written in posts (its slug is in the URL). */
  tag?: string
}
const { all, links, kind, tag } = Astro.props
const listing = kind
  ? {
      posts: all.filter((p) => p.data.kind === kind),
      heading: kindPlural(kind),
      lede: BLOG_KINDS[kind].blurb,
      title: `${kindPlural(kind)} - the AudioSilo blog`,
      description: `${BLOG_KINDS[kind].blurb} From the AudioSilo blog.`,
      view: `kind/${kind}/`,
    }
  : tag
    ? {
        posts: all.filter((p) => p.data.tags.includes(tag)),
        heading: `#${tag}`,
        lede: `Every post tagged ${tag}, newest first.`,
        title: `Posts tagged ${tag} - the AudioSilo blog`,
        description: `Posts about ${tag} on the AudioSilo blog.`,
        view: `tag/${tagSlug(tag)}/`,
      }
    : {
        posts: all,
        heading: 'News and know-how.',
        lede: 'Release notes, guides and video tutorials for running your own audiobook server. Every post says when it was last checked against the software you can download today.',
        title: 'Blog - AudioSilo',
        description: BLOG_DESCRIPTION,
        view: '',
      }
const { title, description, view } = listing
const props = { posts: listing.posts, all, links, kind, tag, heading: listing.heading, lede: listing.lede }
---

<BlogShell title={title} description={description} links={links} view={view}>
  {links.design === 'a' && <AIndex {...props} />}
  {links.design === 'b' && <BIndex {...props} />}
  {links.design === 'c' && <CIndex {...props} />}
</BlogShell>

---
/** A post's hero still in the right Device frame (heroFrame() picks phone, tablet or window). */
import Device from '@/components/media/Device.astro'
import type { HeroFrame } from '@/lib/blog'

interface Props {
  hero: HeroFrame
  /** Rendered width, for srcset. */
  sizes: string
  widths: number[]
  class?: string
}
const { hero, sizes, widths, class: className } = Astro.props
---

<Device
  kind={hero.kind}
  still={hero.still}
  address={hero.address}
  widths={widths}
  sizes={sizes}
  class={className}
/>

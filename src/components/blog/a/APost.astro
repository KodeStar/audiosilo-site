---
/**
 * Design A, "Front page", a post: a wide title block on the post's cover
 * colours, the hero screen (or the video) full width, then a sticky
 * contents rail beside a 70ch column, the change log and related stories.
 */
import Wash from '@/components/site/Wash.astro'
import ACard from './ACard.astro'
import HeroDevice from '../HeroDevice.astro'
import KindChip from '../KindChip.astro'
import PostBody from '../PostBody.astro'
import Revisions from '../Revisions.astro'
import SupersededBanner from '../SupersededBanner.astro'
import Toc from '../Toc.astro'
import Verified from '../Verified.astro'
import VideoBlock from '../VideoBlock.astro'
import { formatDate, isoDate, kindPlural, postPalette, type BlogLinks, type LoadedPost } from '@/lib/blog'

interface Props {
  loaded: LoadedPost
  links: BlogLinks
}
const { loaded, links } = Astro.props
const { post, chapters, minutes, supersededBy, supersedes, related, hero, video } = loaded
const { kind, title, description, published, updated, tags, supersededNote } = post.data
---

<article>
  <header id="top" data-chapter={chapters[0].title} class="relative isolate overflow-hidden pt-6 pb-10 sm:pt-10 sm:pb-14">
    <Wash palette={postPalette(post.id)} />
    <div class="shell relative z-10">
      {supersededBy && <SupersededBanner next={supersededBy} href={links.post(supersededBy.id)} note={supersededNote} class="mb-8 max-w-4xl sm:mb-10" />}
      <nav aria-label="Breadcrumb" class="text-sm text-muted-foreground">
        <a href={links.index} class="hover:text-foreground">Blog</a>
        <span class="mx-1.5 opacity-50" aria-hidden="true">/</span>
        <a href={links.kind(kind)} class="hover:text-foreground">{kindPlural(kind)}</a>
      </nav>
      <h1 class="mt-5 max-w-5xl font-display text-[clamp(2.375rem,5.6vw,4.75rem)] leading-[0.96] font-bold tracking-[-0.045em] text-balance">{title}</h1>
      <p class="t-lede mt-6 max-w-3xl text-foreground/75">{description}</p>
      <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3 border-t border-border pt-5 text-sm text-muted-foreground">
        <KindChip kind={kind} href={links.kind(kind)} />
        <span>
          Published <time datetime={isoDate(published)}>{formatDate(published)}</time>{
            updated && (
              <>
                , updated <time datetime={isoDate(updated)}>{formatDate(updated)}</time>
              </>
            )
          }
        </span>
        <span>{minutes} min read</span>
        <Verified post={post} />
      </div>
    </div>
  </header>

  {
    (video || hero) && (
      <div class="shell">
        <div class="mx-auto max-w-5xl">
          {video ? (
            <VideoBlock video={video} post={post} eager />
          ) : hero && hero.kind === 'phone' ? (
            <div class={`blog-art pal-${postPalette(post.id)} relative h-[min(34rem,90vw)] overflow-hidden rounded-[28px] shadow-[inset_0_0_0_1px_var(--glass-border)]`}>
              <HeroDevice hero={hero} eager sizes="(min-width: 1024px) 17rem, 50vw" widths={[300, 600]} class="absolute top-[9%] left-1/2 w-[min(17rem,48%)] -translate-x-1/2" />
            </div>
          ) : (
            hero && <HeroDevice hero={hero} eager sizes="(min-width: 1024px) 64rem, 94vw" widths={[640, 1280, 1920]} class="w-full" />
          )}
        </div>
      </div>
    )
  }

  <div class="shell grid gap-x-16 py-12 sm:py-16 lg:grid-cols-[14rem_minmax(0,1fr)] xl:grid-cols-[15rem_minmax(0,1fr)_8rem]">
    <aside class="lg:row-span-3"><Toc chapters={chapters} minutes={minutes} /></aside>
    <div class="min-w-0 max-w-[70ch]">
      <PostBody loaded={loaded} />
      {
        tags.length > 0 && (
          <ul class="mt-12 flex flex-wrap gap-2" aria-label="Tags">
            {tags.map((t) => (
              <li>
                <a href={links.tag(t)} class="inline-flex h-8 items-center rounded-full px-3 text-sm text-foreground/80 shadow-[inset_0_0_0_1px_var(--border-strong)] transition-colors hover:bg-foreground/[0.05] hover:text-foreground">
                  #{t}
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <Revisions post={post} links={links} supersededBy={supersededBy} supersedes={supersedes} class="mt-10" />
    </div>
  </div>

  {
    related.length > 0 && (
      <section aria-labelledby="keep-reading" class="border-t border-border">
        <div class="shell py-14 sm:py-20">
          <h2 id="keep-reading" class="t-title">Keep reading</h2>
          <div class="mt-8 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((p) => <ACard post={p} links={links} />)}
          </div>
        </div>
      </section>
    )
  }
</article>

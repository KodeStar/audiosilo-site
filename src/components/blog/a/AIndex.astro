---
/**
 * Design A, "Front page": an editorial magazine. A masthead, a lead story
 * with its screen on the post's cover colours, a latest-release strip, the
 * kind filter and a grid of story cards. Kind and tag pages keep the
 * masthead's rule and the grid.
 */
import Icon from '@/components/Icon.astro'
import Wash from '@/components/site/Wash.astro'
import ACard from './ACard.astro'
import HeroDevice from '../HeroDevice.astro'
import KindChip from '../KindChip.astro'
import KindFilter from '../KindFilter.astro'
import Verified from '../Verified.astro'
import EmptyState from '../EmptyState.astro'
import {
  formatDate,
  heroFrame,
  isCurrent,
  isoDate,
  latestRelease,
  modified,
  postPalette,
  postVideo,
  readingMinutes,
  versionOf,
  type BlogLinks,
  type Post,
} from '@/lib/blog'
import type { BlogKind } from '@/data/blog'
import { cn } from '@/lib/utils'
import { promoteVisibleImg } from '@/lib/promote-visible'

interface Props {
  posts: Post[]
  all: Post[]
  links: BlogLinks
  kind?: BlogKind
  tag?: string
  heading: string
  lede: string
}
const { posts, all, links, kind, tag, heading, lede } = Astro.props
const front = !kind && !tag

const release = front ? latestRelease(all) : undefined
const live = posts.filter((p) => isCurrent(p) && p !== release)
const lead = front ? (live.slice(0, 3).find((p) => p.data.hero || p.data.video) ?? live[0]) : undefined
const grid = posts.filter((p) => p !== lead && p !== release)
const leadHero = lead ? heroFrame(lead) : undefined
const leadVideo = lead ? postVideo(lead) : undefined
const releaseVersion = release ? versionOf(release) : undefined
const newest = all.length ? all.map(modified).sort((a, b) => b.valueOf() - a.valueOf())[0] : undefined
---

<section class="relative isolate overflow-hidden pt-8 pb-4 sm:pt-14">
  {lead && <Wash palette={postPalette(lead.id)} />}
  <div class="shell relative z-10">
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3 border-b-2 border-foreground pb-5">
      <div>
        <p class="t-eyebrow">{front ? 'The AudioSilo blog' : <a href={links.index} class="hover:text-foreground">The AudioSilo blog</a>}</p>
        <h1 class={cn('mt-3', front ? 't-hero' : 't-display')}>{heading}</h1>
      </div>
      <p class="text-sm text-muted-foreground sm:text-right">
        {posts.length} {posts.length === 1 ? 'post' : 'posts'}
        {newest && <> &middot; updated <time datetime={isoDate(newest)}>{formatDate(newest)}</time></>}
        <span class="block"><a href={links.rss} class="link">RSS feed</a></span>
      </p>
    </div>
    <p class="t-lede mt-5 max-w-2xl">{lede}</p>

    {
      lead && (
        <article class="group relative mt-10 grid items-center gap-8 sm:mt-14 lg:grid-cols-12 lg:gap-14">
          <div class={cn('blog-art relative overflow-hidden rounded-[28px] shadow-[inset_0_0_0_1px_var(--glass-border)] lg:col-span-7', leadHero ? 'aspect-[16/11]' : 'aspect-[16/10]', `pal-${postPalette(lead.id)}`)}>
            {leadHero ? (
              leadHero.kind === 'phone' ? (
                <HeroDevice hero={leadHero} eager sizes="(min-width: 1024px) 15rem, 40vw" widths={[300, 600]} class="absolute top-[9%] left-1/2 w-[32%] -translate-x-1/2" />
              ) : (
                <HeroDevice hero={leadHero} eager sizes="(min-width: 1024px) 44rem, 96vw" widths={[640, 1280]} class="absolute top-[11%] left-[8%] w-[100%]" />
              )
            ) : leadVideo?.type === 'tour' ? (
              <>
                {(['light', 'dark'] as const).map((t) => (
                  <img
                    src={leadVideo.files.poster[t]}
                    srcset={leadVideo.poster?.srcset[t]}
                    sizes="(min-width: 1024px) 44rem, 96vw"
                    alt=""
                    loading="lazy"
                    decoding="async"
                    width={leadVideo.poster?.width}
                    height={leadVideo.poster?.height}
                    data-lead-poster={t}
                    class={cn('absolute inset-0 size-full object-cover', t === 'light' ? 'dark:hidden' : 'hidden dark:block')}
                  />
                ))}
                <script is:inline set:html={promoteVisibleImg('data-lead-poster')} />
                <span class="absolute inset-0 grid place-items-center" aria-hidden="true">
                  <span class="play-btn play-ink size-16 sm:size-20">
                    <Icon name="play" class="size-7 translate-x-0.5" />
                  </span>
                </span>
              </>
            ) : (
              <p class="absolute right-[6%] bottom-[8%] left-[6%] font-display text-[clamp(2.5rem,6vw,5.5rem)] leading-[0.9] font-extrabold tracking-[-0.05em] text-foreground/85" aria-hidden="true">
                {lead.data.title.split(':')[0]}
              </p>
            )}
          </div>
          <div class="lg:col-span-5">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted-foreground">
              <KindChip kind={lead.data.kind} href={links.kind(lead.data.kind)} />
              <time datetime={isoDate(lead.data.published)}>{formatDate(lead.data.published)}</time>
              <span aria-hidden="true">&middot;</span>
              <span>{readingMinutes(lead.body)} min read</span>
            </div>
            <h2 class="mt-4 font-display text-[clamp(2rem,3.6vw,3.25rem)] leading-[1] font-bold tracking-[-0.04em] text-balance">
              <a href={links.post(lead.id)} class="stretch-link underline decoration-transparent decoration-[3px] underline-offset-[6px] transition-colors group-hover:decoration-foreground/30">{lead.data.title}</a>
            </h2>
            <p class="t-lede mt-4">{lead.data.description}</p>
            <p class="mt-5 text-sm text-muted-foreground"><Verified post={lead} /></p>
            <p class="mt-6 inline-flex items-center gap-2 font-semibold" aria-hidden="true">
              Read the {lead.data.video ? 'tutorial' : 'story'}
              <svg class="size-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
            </p>
          </div>
        </article>
      )
    }
  </div>
</section>

{
  release && (
    <section aria-labelledby="latest-release" class="shell mt-10 sm:mt-14">
      {/* The columns are z-indexed grid items, not positioned, so the title's stretched link covers the whole tile; the right column lets clicks through to it. */}
      <div class="tile group grid gap-5 p-6 sm:p-8 md:grid-cols-[auto_minmax(0,1fr)_auto] md:items-center md:gap-10">
        <Wash palette="console" edge="none" class="opacity-60" />
        <div class="z-10">
          <p class="t-eyebrow">Latest release</p>
          {releaseVersion && (
            <p class="mt-1 flex items-baseline gap-2">
              <span class="t-stat text-[clamp(3.25rem,7vw,5.5rem)]">{releaseVersion.version}</span>
              <span class="text-sm font-semibold text-muted-foreground">{releaseVersion.product}</span>
            </p>
          )}
        </div>
        <div class="z-10 min-w-0">
          <h2 id="latest-release" class="t-title text-balance">
            <a href={links.post(release.id)} class="stretch-link underline decoration-transparent decoration-2 underline-offset-4 group-hover:decoration-foreground/30">{release.data.title}</a>
          </h2>
          <p class="line-clamp-2 mt-2 text-muted-foreground">{release.data.description}</p>
        </div>
        <div class="pointer-events-none z-10 flex items-center justify-between gap-4 text-sm md:flex-col md:items-end">
          <time datetime={isoDate(release.data.published)} class="text-muted-foreground">{formatDate(release.data.published)}</time>
          <span class="inline-flex items-center gap-2 font-semibold" aria-hidden="true">
            Release notes
            <svg class="size-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
          </span>
        </div>
      </div>
    </section>
  )
}

<section aria-labelledby="all-posts" class="shell pt-14 pb-20 sm:pt-20 sm:pb-28">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <h2 id="all-posts" class="t-title">{front ? 'Latest' : tag ? `Tagged ${tag}` : 'Every post'}</h2>
    <KindFilter all={all} links={links} current={kind} none={!!tag} />
  </div>
  {
    all.length === 0 ? (
      <div class="mt-8"><EmptyState rss={links.rss} /></div>
    ) : (
      <div class="mt-10 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
        {grid.map((p) => <ACard post={p} links={links} />)}
      </div>
    )
  }
</section>

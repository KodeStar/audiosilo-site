---
/**
 * Design A's story card: cover-colour art (the hero still peeking out of
 * its device, a tour's first frame, a release's version, or the kind set
 * large), then kind, date, title and summary. The title link covers the card.
 */
import Device from '@/components/media/Device.astro'
import HeroDevice from '../HeroDevice.astro'
import KindChip from '../KindChip.astro'
import { formatDate, heroFrame, isoDate, kindLabel, postPalette, postVideo, readingMinutes, versionOf, type BlogLinks, type Post } from '@/lib/blog'
import { cn } from '@/lib/utils'

interface Props {
  post: Post
  links: BlogLinks
  /** Heading level of the title (h3 in a grid under an h2). */
  level?: 'h2' | 'h3'
  class?: string
}
const { post, links, level = 'h3', class: className } = Astro.props
const { kind, title, description, published, supersededBy } = post.data
const hero = heroFrame(post)
const video = postVideo(post)
const version = kind === 'release' ? versionOf(post) : undefined
const H = level
---

<article class={cn('group relative flex flex-col', supersededBy && 'opacity-80', className)}>
  <div class={cn('blog-art relative aspect-[16/10] overflow-hidden rounded-2xl shadow-[inset_0_0_0_1px_var(--glass-border)] transition-transform duration-300 ease-(--ease-out) group-hover:-translate-y-1', `pal-${postPalette(post.id)}`)} aria-hidden="true">
    {
      hero ? (
        hero.kind === 'phone' ? (
          <HeroDevice hero={hero} decorative sizes="(min-width: 1024px) 9rem, 30vw" widths={[240, 480]} class="absolute top-[12%] left-1/2 w-[34%] -translate-x-1/2" />
        ) : (
          <HeroDevice hero={hero} decorative sizes="(min-width: 1024px) 26rem, 90vw" widths={[480, 960]} class="absolute top-[14%] left-[10%] w-[104%]" />
        )
      ) : video?.type === 'tour' ? (
        <Device kind="window" aspect={video.tour.aspect} address={video.tour.name === "server" ? "your-server/admin" : undefined} class="absolute top-[14%] left-[10%] w-[104%]">
          <img src={video.files.poster.light} alt="" loading="lazy" decoding="async" width="1600" height="900" class="device-media object-cover dark:hidden" />
          <img src={video.files.poster.dark} alt="" loading="lazy" decoding="async" width="1600" height="900" class="device-media hidden object-cover dark:block" />
        </Device>
      ) : version ? (
        <p class="absolute bottom-[-0.12em] left-[6%] font-display text-[clamp(5rem,10vw,8rem)] leading-none font-extrabold tracking-[-0.06em] text-foreground/85 tabular-nums">
          {version.version}
        </p>
      ) : (
        <p class="absolute bottom-[-0.2em] left-[5%] font-display text-[clamp(4.5rem,9vw,7rem)] leading-none font-extrabold tracking-[-0.05em] text-transparent [-webkit-text-stroke:2px_color-mix(in_oklab,var(--foreground)_60%,transparent)]">
          {kindLabel(kind)}
        </p>
      )
    }
    {
      video && (
        <span class="absolute top-3 right-3 inline-flex h-7 items-center gap-1.5 rounded-full bg-black/45 px-2.5 text-xs font-semibold text-white backdrop-blur">
          <svg class="size-3" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11.04-6.86a1 1 0 0 0 0-1.72L9.5 4.28A1 1 0 0 0 8 5.14Z" /></svg>
          {video.duration ?? 'Video'}
        </span>
      )
    }
  </div>
  <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted-foreground">
    <KindChip kind={kind} href={links.kind(kind)} />
    <time datetime={isoDate(published)}>{formatDate(published)}</time>
    <span aria-hidden="true">&middot;</span>
    <span>{readingMinutes(post.body)} min read</span>
  </div>
  <H class="mt-3 font-display text-[1.375rem] leading-[1.15] font-bold tracking-[-0.025em] text-balance">
    <a href={links.post(post.id)} class="stretch-link underline decoration-transparent decoration-2 underline-offset-4 transition-colors group-hover:decoration-foreground/30">{title}</a>
  </H>
  <p class="clamp-3 mt-2 text-[0.9375rem] leading-relaxed text-muted-foreground">{description}</p>
  {
    supersededBy && (
      <p class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-foreground/80">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
        Replaced by a newer post
      </p>
    )
  }
</article>

---
/**
 * One entry on design B's timeline: the day, a node on the line (a filled
 * ring for a release, a hollow dot otherwise, dashed when replaced) and the
 * post with its version chip. The title link covers the entry.
 */
import Icon from '@/components/Icon.astro'
import KindChip from '../KindChip.astro'
import VersionChip from '../VersionChip.astro'
import { formatMonthShort, formatShortDate, isoDate, readingMinutes, versionOf, type BlogLinks, type Post } from '@/lib/blog'
import { cn } from '@/lib/utils'

interface Props {
  post: Post
  links: BlogLinks
  /** The post that replaces this one, for the forward link. */
  next?: Post
}
const { post, links, next } = Astro.props
const { kind, title, description, published, verified, video } = post.data
const release = kind === 'release'
const version = versionOf(post)
const day = published.getUTCDate()
const month = formatMonthShort(published)
---

<li class="group relative grid grid-cols-[3rem_1.25rem_minmax(0,1fr)] gap-x-3 py-6 sm:grid-cols-[4rem_1.5rem_minmax(0,1fr)] sm:gap-x-4">
  <time datetime={isoDate(published)} class="pt-0.5 text-right leading-none">
    <span class="block font-display text-[1.625rem] font-bold tracking-[-0.03em] tabular-nums">{day}</span>
    <span class="mt-1 block text-[11px] font-semibold tracking-[0.12em] text-muted-foreground uppercase">{month}</span>
  </time>
  <span class="relative z-[1] flex justify-center pt-2" aria-hidden="true">
    <span
      class={cn(
        'rounded-full shadow-[0_0_0_5px_var(--background)]',
        release && !next ? 'size-3.5 bg-foreground' : 'size-2.5 bg-background',
        !(release && !next) && (next ? 'border border-dashed border-muted-foreground' : 'border-2 border-border-strong'),
      )}
    ></span>
  </span>
  {/* A replaced entry dims its title only: dimmed small text would drop below AA contrast. */}
  <div class="min-w-0 rounded-2xl">
    <div class="flex flex-wrap items-center gap-2">
      {version && release && <VersionChip product={version.product} version={version.version} />}
      <KindChip kind={kind} href={links.kind(kind)} />
    </div>
    <h3 class={cn('mt-2.5 font-display font-bold text-balance', next && 'opacity-75', release ? 'text-[clamp(1.375rem,2.1vw,1.75rem)] leading-[1.08] tracking-[-0.03em]' : 'text-[1.25rem] leading-[1.15] tracking-[-0.022em]')}>
      <a href={links.post(post.id)} class="stretch-link underline decoration-transparent decoration-2 underline-offset-4 transition-colors group-hover:decoration-foreground/30">{title}</a>
    </h3>
    <p class="mt-2 max-w-[62ch] text-[0.9375rem] leading-relaxed text-muted-foreground">{description}</p>
    <p class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-[13px] text-muted-foreground">
      <span>{readingMinutes(post.body)} min read</span>
      {
        video && (
          <span class="inline-flex items-center gap-1">
            <Icon name="play" class="size-3" />
            Video{video.duration && `, ${video.duration}`}
          </span>
        )
      }
      <span>Checked <time datetime={isoDate(verified)}>{formatShortDate(verified)}</time></span>
    </p>
    {
      next && (
        <p class="relative z-[5] mt-3 text-sm">
          <span class="text-muted-foreground">Replaced by </span>
          <a href={links.post(next.id)} class="link font-semibold">{next.data.title}</a>
        </p>
      )
    }
  </div>
</li>

---
/**
 * Design B, "Changelog journal": release-cadence led. A ledger of the
 * current versions, then every post on one timeline grouped by month, with
 * the evergreen guides and tutorials pinned in a "Start here" rail.
 */
import BEntry from './BEntry.astro'
import KindFilter from '../KindFilter.astro'
import EmptyState from '../EmptyState.astro'
import {
  formatDate,
  formatMonth,
  isoDate,
  kindLabel,
  kindsIn,
  kindPlural,
  readingMinutes,
  tagsIn,
  versionOf,
  type BlogLinks,
  type Post,
} from '@/lib/blog'
import type { BlogKind } from '@/data/blog'

interface Props {
  posts: Post[]
  all: Post[]
  links: BlogLinks
  kind?: BlogKind
  tag?: string
  heading: string
  lede: string
}
const { posts, all, links, kind, tag, heading, lede } = Astro.props
const front = !kind && !tag
const byId = new Map(all.map((p) => [p.id, p]))

// The newest version each product has had a release (or feature) post about.
const current = new Map<string, { version: string; post: Post }>()
for (const p of all) {
  if (p.data.supersededBy || (p.data.kind !== 'release' && p.data.kind !== 'feature')) continue
  const v = versionOf(p)
  if (v && !current.has(v.product)) current.set(v.product, { version: v.version, post: p })
}

const months: { key: string; label: string; posts: Post[] }[] = []
for (const p of posts) {
  const key = isoDate(p.data.published).slice(0, 7)
  const last = months[months.length - 1]
  if (last?.key === key) last.posts.push(p)
  else months.push({ key, label: formatMonth(p.data.published), posts: [p] })
}

const startHere = all.filter((p) => (p.data.kind === 'guide' || p.data.kind === 'tutorial') && !p.data.supersededBy).slice(0, 6)
const tags = [...tagsIn(all)].sort((a, b) => b[1].posts.length - a[1].posts.length).slice(0, 14)
---

<section class="shell pt-10 pb-6 sm:pt-16 sm:pb-10">
  <div class="grid items-end gap-8 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-16">
    <div>
      <p class="t-eyebrow">{front ? 'Changelog and journal' : <a href={links.index} class="hover:text-foreground">Changelog and journal</a>}</p>
      <h1 class="t-display mt-3">{front ? 'What\'s new in AudioSilo.' : heading}</h1>
      <p class="t-lede mt-4 max-w-2xl">{lede}</p>
    </div>
    {
      current.size > 0 && (
        <div class="rounded-2xl shadow-[inset_0_0_0_1px_var(--border-strong)]">
          <p class="flex items-center justify-between border-b border-border px-5 py-3 text-sm">
            <span class="font-semibold">Current versions</span>
            <a href={links.rss} class="inline-flex items-center gap-1.5 text-muted-foreground hover:text-foreground">
              <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 11a8 8 0 0 1 8 8M5 5a14 14 0 0 1 14 14" /><circle cx="6" cy="18" r="1.4" fill="currentColor" /></svg>
              RSS
            </a>
          </p>
          <dl class="divide-y divide-border">
            {[...current].map(([product, c]) => (
              <div class="group relative flex items-baseline justify-between gap-4 px-5 py-3.5">
                <dt class="text-sm text-muted-foreground">{product}</dt>
                <dd class="text-right">
                  <a href={links.post(c.post.id)} class="stretch-link font-mono text-lg font-semibold tabular-nums group-hover:underline">{c.version}</a>
                  <span class="block text-xs text-subtle-foreground">{formatDate(c.post.data.published)}</span>
                </dd>
              </div>
            ))}
          </dl>
        </div>
      )
    }
  </div>
</section>

<div class="shell grid gap-10 pb-20 sm:pb-28 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-16">
  <div class="min-w-0">
    <KindFilter all={all} links={links} current={kind} none={!!tag} class="mb-4 lg:hidden" />
    {posts.length === 0 && <EmptyState rss={links.rss} />}
    {
      months.map((m) => (
        <section aria-labelledby={`m-${m.key}`}>
          <h2 id={`m-${m.key}`} class="sticky top-(--header-h) z-10 -mx-4 flex items-baseline gap-3 border-b border-border bg-background/85 px-4 py-3 backdrop-blur-md sm:mx-0 sm:px-0">
            <span class="font-display text-xl font-bold tracking-[-0.02em]">{m.label}</span>
            <span class="text-sm text-muted-foreground">
              {m.posts.length} {m.posts.length === 1 ? 'post' : 'posts'}
            </span>
          </h2>
          <ol class="journal-line [--line-x:4.375rem] sm:[--line-x:5.75rem]">
            {m.posts.map((p) => <BEntry post={p} links={links} next={p.data.supersededBy ? byId.get(p.data.supersededBy.id) : undefined} />)}
          </ol>
        </section>
      ))
    }
  </div>

  <aside class="order-first lg:order-none" aria-label="Start here">
    <div class="space-y-8 lg:sticky lg:top-[calc(var(--header-h)+1.5rem)]">
      {
        startHere.length > 0 && (
          <section aria-labelledby="start-here" class="rounded-2xl bg-muted/60 p-2 shadow-[inset_0_0_0_1px_var(--border)]">
            <h2 id="start-here" class="t-eyebrow px-3 pt-3 pb-2">Start here</h2>
            <ul>
              {startHere.map((p) => (
                <li>
                  <a href={links.post(p.id)} class="group flex gap-3 rounded-xl p-3 transition-colors hover:bg-background/70">
                    <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-background text-foreground/80 shadow-[inset_0_0_0_1px_var(--border)]" aria-hidden="true">
                      {p.data.kind === 'tutorial' ? (
                        <svg class="size-3.5 translate-x-px" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11.04-6.86a1 1 0 0 0 0-1.72L9.5 4.28A1 1 0 0 0 8 5.14Z" /></svg>
                      ) : (
                        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H11v16H5.5A1.5 1.5 0 0 1 4 18.5Z" /><path d="M20 5.5A1.5 1.5 0 0 0 18.5 4H13v16h5.5a1.5 1.5 0 0 0 1.5-1.5Z" /></svg>
                      )}
                    </span>
                    <span class="min-w-0">
                      <span class="block text-[0.9375rem] leading-snug font-semibold text-balance group-hover:underline group-hover:decoration-foreground/30 group-hover:underline-offset-4">{p.data.title}</span>
                      <span class="mt-0.5 block text-xs text-muted-foreground">
                        {kindLabel(p.data.kind)} &middot; {readingMinutes(p.body)} min{p.data.video?.duration && <> &middot; {p.data.video.duration} video</>}
                      </span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
      <section aria-labelledby="browse" class="hidden lg:block">
        <h2 id="browse" class="t-eyebrow">Browse</h2>
        <ul class="mt-3 divide-y divide-border border-y border-border text-[0.9375rem]">
          <li>
            <a href={links.index} aria-current={front ? 'page' : undefined} class="flex justify-between py-2.5 text-foreground/80 hover:text-foreground aria-[current=page]:font-semibold aria-[current=page]:text-foreground">
              Everything <span class="font-mono text-xs text-muted-foreground tabular-nums">{all.length}</span>
            </a>
          </li>
          {kindsIn(all).map((k) => (
            <li>
              <a href={links.kind(k.kind)} aria-current={kind === k.kind ? 'page' : undefined} class="flex justify-between py-2.5 text-foreground/80 hover:text-foreground aria-[current=page]:font-semibold aria-[current=page]:text-foreground">
                {kindPlural(k.kind)} <span class="font-mono text-xs text-muted-foreground tabular-nums">{k.count}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
      {
        tags.length > 0 && (
          <section aria-labelledby="topics" class="hidden lg:block">
            <h2 id="topics" class="t-eyebrow">Topics</h2>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {tags.map(([slug, t]) => (
                <li>
                  <a href={links.tag(t.tag)} aria-current={tag === t.tag ? 'page' : undefined} class="inline-flex h-7 items-center rounded-full px-2.5 text-[13px] text-foreground/75 shadow-[inset_0_0_0_1px_var(--border-strong)] hover:text-foreground aria-[current=page]:bg-primary aria-[current=page]:text-primary-foreground" data-slug={slug}>
                    #{t.tag}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </aside>
</div>

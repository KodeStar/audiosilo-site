---
/**
 * A terminal-style code block with a copy button. Works in both themes:
 * a deep-ink panel in dark, a soft porcelain panel in light.
 */
interface Props {
  code: string
  filename?: string
  /** Prefix lines with a shell prompt in the gutter. */
  prompt?: boolean
  class?: string
}
const { code, filename, prompt = false, class: className } = Astro.props
const trimmed = code.trim()
---

<div class:list={['code-block not-prose my-5 overflow-hidden rounded-2xl bg-muted/80 shadow-[inset_0_0_0_1px_var(--border)]', className]}>
  <div class="flex items-center justify-between gap-3 border-b border-border px-4 py-2.5">
    <span class="flex min-w-0 items-center gap-2 font-mono text-xs text-muted-foreground">
      <span class="flex gap-1" aria-hidden="true"><i class="size-2 rounded-full bg-border-strong"></i><i class="size-2 rounded-full bg-border-strong"></i><i class="size-2 rounded-full bg-border-strong"></i></span>
      <span class="truncate">{filename ?? 'Terminal'}</span>
    </span>
    <button
      type="button"
      class="copy-btn inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium text-muted-foreground transition-colors hover:bg-foreground/[0.06] hover:text-foreground"
      aria-label="Copy code to clipboard"
    >
      <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15V5a2 2 0 0 1 2-2h10" /></svg>
      <span class="copy-label">Copy</span>
    </button>
  </div>
  <pre class:list={['overflow-x-auto p-4 font-mono text-[13px] leading-relaxed text-foreground sm:p-5', prompt && 'with-prompt']}><code>{trimmed}</code></pre>
</div>

<style>
  .with-prompt code {
    display: block;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.code-block .copy-btn').forEach((btn) => {
    if (btn.dataset.ready) return
    btn.dataset.ready = 'true'
    btn.addEventListener('click', () => {
      const text = btn.closest('.code-block')?.querySelector('code')?.textContent ?? ''
      const label = btn.querySelector<HTMLElement>('.copy-label')
      navigator.clipboard
        .writeText(text)
        .then(() => {
          if (!label) return
          label.textContent = 'Copied'
          window.setTimeout(() => (label.textContent = 'Copy'), 1600)
        })
        .catch(() => {})
    })
  })
</script>

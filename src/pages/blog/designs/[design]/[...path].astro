---
/**
 * The design previews: /blog/designs/<a|b|c>/ plus every post, kind and tag
 * below it, each rendered in that design (noindex, out of the sitemap).
 * Delete this folder once a design is chosen (src/data/blog.ts).
 */
import type { GetStaticPaths } from 'astro'
import BlogIndex from '@/components/blog/BlogIndex.astro'
import BlogPost from '@/components/blog/BlogPost.astro'
import type { BlogDesign, BlogKind } from '@/data/blog'
import { blogLinks, designIds, getPosts, kindsIn, tagsIn, type Post } from '@/lib/blog'

type View = { type: 'index' } | { type: 'post'; post: Post } | { type: 'kind'; kind: BlogKind } | { type: 'tag'; tag: string }

export const getStaticPaths = (async () => {
  const all = await getPosts()
  const views: { path: string | undefined; view: View }[] = [
    { path: undefined, view: { type: 'index' } },
    ...all.map((post) => ({ path: post.id, view: { type: 'post' as const, post } })),
    ...kindsIn(all).map(({ kind }) => ({ path: `kind/${kind}`, view: { type: 'kind' as const, kind } })),
    ...[...tagsIn(all)].map(([slug, { tag }]) => ({ path: `tag/${slug}`, view: { type: 'tag' as const, tag } })),
  ]
  return designIds.flatMap((design) => views.map(({ path, view }) => ({ params: { design, path }, props: { design, view, all } })))
}) satisfies GetStaticPaths

interface Props {
  design: BlogDesign
  view: View
  all: Post[]
}
const { design, view, all } = Astro.props
const links = blogLinks(design, true)
---

{view.type === 'post' && <BlogPost post={view.post} all={all} links={links} />}
{view.type === 'index' && <BlogIndex all={all} links={links} />}
{view.type === 'kind' && <BlogIndex all={all} kind={view.kind} links={links} />}
{view.type === 'tag' && <BlogIndex all={all} tag={view.tag} links={links} />}

---
import type { GetStaticPaths } from 'astro'
import BlogIndex from '@/components/blog/BlogIndex.astro'
import { BLOG_DESIGN, type BlogKind } from '@/data/blog'
import { blogLinks, getPosts, kindsIn, type Post } from '@/lib/blog'

export const getStaticPaths = (async () => {
  const all = await getPosts()
  return kindsIn(all).map(({ kind }) => ({ params: { kind }, props: { kind, all } }))
}) satisfies GetStaticPaths

interface Props {
  kind: BlogKind
  all: Post[]
}
const { kind, all } = Astro.props
---

<BlogIndex all={all} kind={kind} links={blogLinks(BLOG_DESIGN, false)} />

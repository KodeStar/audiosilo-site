---
import Base from '@/layouts/Base.astro'
import Wash from '@/components/site/Wash.astro'
import BarScrubber from '@/components/site/BarScrubber.astro'
---

<Base hasHero miniBar={false} title="Page not found - AudioSilo" description="This page doesn't exist. Head back to the AudioSilo home page.">
  <section class="relative isolate flex min-h-[86svh] items-center overflow-hidden pt-(--header-h)">
    <Wash palette="dracula" />
    <div class="shell relative z-10 flex flex-col items-center py-20 text-center">
      <p class="t-eyebrow">404 &middot; Chapter not found</p>
      <h1 class="t-hero mt-6 max-w-3xl">This chapter doesn't exist.</h1>
      <p class="t-lede mx-auto mt-6 max-w-md">The page you were after has moved, or was never here.</p>
      <BarScrubber class="mt-12 h-10 w-full max-w-md" bars={56} played={1} seed={404} />
      <a href="/" class="mt-12 inline-flex h-12 items-center gap-2 rounded-full bg-primary px-6 text-[0.9375rem] font-semibold text-primary-foreground hover:opacity-90">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7" /><path d="M3 4v5h5" /></svg>
        Back to the beginning
      </a>
    </div>
  </section>
</Base>

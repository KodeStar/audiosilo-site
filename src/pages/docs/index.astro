---
import { GITHUB_SERVER_URL } from '@/data/links'
import { ANDROID_ASIDE } from '@/data/status'
import DocsLayout from '../../layouts/DocsLayout.astro'
import Icon from '../../components/Icon.astro'

const cards = [
  {
    icon: 'rocket',
    title: 'Installation',
    body: 'Run the server with Docker or a native binary, and meet your admin credentials.',
    href: '/docs/installation',
  },
  {
    icon: 'settings',
    title: 'Configuration',
    body: 'Every config.yaml key and its environment-variable override, explained.',
    href: '/docs/configuration',
  },
  {
    icon: 'globe',
    title: 'Reverse proxy & TLS',
    body: 'Expose AudioSilo safely with a reverse proxy, TLS and trusted proxies.',
    href: '/docs/reverse-proxy',
  },
  {
    icon: 'check',
    title: 'First run',
    body: 'Add a library and pair your first device with an auth code or QR.',
    href: '/docs/first-run',
  },
] as const
---
<DocsLayout
  title="AudioSilo documentation"
  description="Documentation for AudioSilo Server: installation, configuration, exposing it safely, and pairing your first device."
>
  <p>
    AudioSilo is a <strong>self-hosted audiobook platform</strong>: a small, open-source server written
    in Go (AGPLv3), plus a player for the web, iPhone and iPad ({ANDROID_ASIDE}). You run the
    server, point it at a folder of audiobooks, and connect from any device.
  </p>
  <p>
    The server exposes a JSON API, a baked-in admin/connect web UI, and (in the Docker image and the
    native binaries) the web player at <code>/web</code>. It's designed with the goal of being
    <strong>safe to leave exposed to the internet</strong>: no default passwords, app-layer hardening
    (rate limiting and brute-force lockout), and configurable TLS.
  </p>

  <h2>Start here</h2>
  <div class="mt-4 grid gap-4 sm:grid-cols-2">
    {
      cards.map((c) => (
        <a
          href={c.href}
          class="tile group block p-5 !no-underline transition-transform duration-200 hover:-translate-y-0.5"
        >
          <div class="mb-2 flex items-center gap-2">
            <span class="inline-flex size-9 items-center justify-center rounded-xl bg-foreground/[0.07] text-foreground">
              <Icon name={c.icon} class="h-5 w-5" />
            </span>
            <span class="font-semibold text-foreground">{c.title}</span>
          </div>
          <p class="text-sm font-normal text-muted-foreground">{c.body}</p>
        </a>
      ))
    }
  </div>

  <h2>Looking to install?</h2>
  <p>
    Head to the <a href="/download">download page</a> to grab the server, or jump straight to the
    <a href="/docs/installation">installation guide</a>. The server is licensed under
    <strong>AGPL-3.0</strong>; the source lives on
    <a href={GITHUB_SERVER_URL} target="_blank" rel="noopener">GitHub</a>.
  </p>
</DocsLayout>

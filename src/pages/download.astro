---
import Base from '@/layouts/Base.astro'
import Wash from '@/components/site/Wash.astro'
import Arrow from '@/components/site/Arrow.astro'
import InstallTabs from '@/components/site/InstallTabs.tsx'
import CodeBlock from '@/components/CodeBlock.astro'
import VersionBadge from '@/components/VersionBadge.tsx'
import { DEMO_URL, GITHUB_SERVER_RELEASES_URL, GITHUB_SERVER_URL } from '@/data/links'
import { demoLibrary } from '@/data/demo'
import AppCards from '@/components/site/AppCards.astro'
import Icon from '@/components/Icon.astro'
import { APP_PLATFORMS } from '@/data/status'

const source = `git clone ${GITHUB_SERVER_URL}
cd audiosilo-server
go build -o bin/audiosilo ./cmd/audiosilo

# First run prints the admin password and auth code once. Save them.
AUDIOSILO_TLS_MODE=off ./bin/audiosilo --data ./data`

const platforms = [
  ['Linux', 'amd64 and arm64: .tar.gz, .deb and .rpm (with a systemd unit)'],
  ['macOS', 'Apple silicon and Intel: .tar.gz'],
  ['Windows', 'amd64 and arm64: .zip'],
]
---

<Base
  hasHero
  title="Download AudioSilo - server and apps"
  description={`Run AudioSilo Server with Docker or a native binary for Linux, macOS or Windows, then listen in the web player, on ${APP_PLATFORMS}.`}
>
  <section id="top" data-chapter="Download" class="relative isolate overflow-hidden pt-[calc(var(--header-h)+3rem)] pb-12 sm:pt-[calc(var(--header-h)+5rem)]">
    <Wash palette="console" />
    <div class="shell relative z-10 max-w-4xl">
      <p class="t-eyebrow reveal">Download &middot; server <VersionBadge client:settled /></p>
      <h1 class="t-hero reveal reveal-d1 mt-5">Install one thing.</h1>
      <p class="t-lede reveal reveal-d2 mt-6 max-w-2xl text-foreground/75">
        The server is the only thing you install. It serves the web player and the API the apps
        connect to. Docker is the easy path for a NAS, a home server or a VPS.
      </p>
    </div>
  </section>

  <section id="docker" data-chapter="Docker" class="py-12 sm:py-16">
    <div class="shell grid gap-10 lg:grid-cols-12">
      <div class="reveal lg:col-span-4">
        <h2 class="t-title">Docker <span class="ml-1 align-middle text-xs font-semibold tracking-[0.1em] text-muted-foreground uppercase">Recommended</span></h2>
        <p class="mt-4 text-[1.0625rem] leading-relaxed text-foreground/80">
          <span class="ic">ghcr.io/kodestar/audiosilo-server</span> for amd64 and arm64, with the web
          player and ffmpeg inside. Only <span class="ic">/data</span> is persisted; mount your books
          read-only.
        </p>
        <p class="mt-4 text-[0.9375rem] text-muted-foreground">
          Updating is a new image: <span class="ic">docker compose pull &amp;&amp; docker compose up -d</span>.
          Back up the data folder first.
        </p>
      </div>
      <div class="reveal reveal-d1 min-w-0 lg:col-span-8"><InstallTabs client:visible /></div>
    </div>
  </section>

  <section id="binaries" data-chapter="Binaries" class="py-12 sm:py-16">
    <div class="shell grid gap-10 lg:grid-cols-12">
      <div class="reveal lg:col-span-4">
        <h2 class="t-title">Native binaries</h2>
        <p class="mt-4 text-[1.0625rem] leading-relaxed text-foreground/80">
          One download per system on GitHub Releases. The web player is built in, and ffmpeg is
          fetched on first use if you don't have it. Run with <span class="ic">--setup</span> for a
          browser wizard.
        </p>
        <a href={GITHUB_SERVER_RELEASES_URL} target="_blank" rel="noopener" class="mt-6 inline-flex h-11 items-center gap-2 rounded-full bg-primary px-5 text-sm font-semibold text-primary-foreground hover:opacity-90">
          <Icon name="download" class="size-4" /> Server releases
        </a>
      </div>
      <ul class="reveal reveal-d1 divide-y divide-border self-start border-y border-border lg:col-span-8">
        {
          platforms.map(([os, files]) => (
            <li class="flex flex-col gap-1 py-5 sm:flex-row sm:items-baseline sm:gap-8">
              <span class="w-28 shrink-0 font-display text-xl font-semibold tracking-[-0.02em]">{os}</span>
              <span class="text-[0.9375rem] text-muted-foreground">{files}</span>
            </li>
          ))
        }
        <li class="py-5 text-[0.9375rem] text-muted-foreground">Every release also carries <span class="ic">checksums.txt</span>.</li>
      </ul>
    </div>
  </section>

  <section id="source" data-chapter="From source" class="py-12 sm:py-16">
    <div class="shell grid gap-10 lg:grid-cols-12">
      <div class="reveal lg:col-span-4">
        <h2 class="t-title">From source</h2>
        <p class="mt-4 text-[1.0625rem] leading-relaxed text-foreground/80">
          Pure Go with no C toolchain needed (SQLite is pure Go too), so it builds wherever Go 1.26
          does. AGPLv3.
        </p>
      </div>
      <div class="reveal reveal-d1 min-w-0 lg:col-span-8"><CodeBlock code={source} /></div>
    </div>
  </section>

  <section id="apps" data-chapter="The apps" class="py-12 pb-24 sm:py-16 sm:pb-32">
    <div class="shell">
      <h2 class="t-display reveal">Then press play.</h2>
      <div class="mt-10">
        <AppCards webTitle="Already on your server" pairNote="Pair it with an invite link or QR code.">
          <p class="mt-3 text-[0.9375rem] text-foreground/80">Open <span class="ic">/web</span> and add it to your home screen. Try it first on the demo, with {demoLibrary.shelf} on the shelf.</p>
          <a href={DEMO_URL} target="_blank" rel="noopener" class="group mt-auto inline-flex items-center gap-1.5 pt-5 text-sm font-semibold">Open the demo <Arrow /></a>
        </AppCards>
      </div>
      <p class="reveal mt-10 text-sm text-muted-foreground">
        New to this? The <a href="/docs/installation" class="link">installation guide</a> walks through a Docker setup end to end.
      </p>
    </div>
  </section>
</Base>
